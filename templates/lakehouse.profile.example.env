# Lakehouse connection profile — env-var variant (example)
#
# Same contract as lakehouse.profile.example.toml, flattened to env vars:
#   [section] key = value   <=>   LAKEHOUSE_<SECTION>_<KEY>=value   (upper-cased)
# Lists (naming.schemas) are comma-separated; booleans are true/false.
#
# Use it either way:
#   1. as a file:   copy to <name>.profile.env and select it with
#                   --file <name>.profile.env  (or LAKEHOUSE_PROFILE_FILE=<path>)
#   2. as the environment: `set -a; . ./<name>.profile.env; set +a` — an env-only profile
#                   is selected when LAKEHOUSE_PROFILE_NAME is set and no file is chosen.
# Any LAKEHOUSE_<SECTION>_<KEY> in the process environment overrides the same key from a
# profile file. Full reference: docs/connection-profile.md
#
# Secrets are never written here: *_ENV keys hold the NAME of the env var with the secret.

# [profile] — required
LAKEHOUSE_PROFILE_NAME=default
LAKEHOUSE_PROFILE_INVOCATION=local

# [k8s] — required only when an effective invocation is "k8s"
LAKEHOUSE_K8S_NAMESPACE=
LAKEHOUSE_K8S_CONTEXT=

# [spark]
LAKEHOUSE_SPARK_CONNECT_URI=sc://SPARK_HOST:15002
LAKEHOUSE_SPARK_CONTAINER=
LAKEHOUSE_SPARK_POD=

# [unity_catalog]
LAKEHOUSE_UNITY_CATALOG_REST_URL=http://UC_HOST:8080/api/2.1/unity-catalog
LAKEHOUSE_UNITY_CATALOG_ICEBERG_REST=http://UC_HOST:8080/api/2.1/unity-catalog/iceberg/v1
LAKEHOUSE_UNITY_CATALOG_TOKEN_ENV=LAKEHOUSE_UC_TOKEN

# [kafka]
LAKEHOUSE_KAFKA_BOOTSTRAP_SERVERS=KAFKA_HOST:9092
LAKEHOUSE_KAFKA_CONTAINER=
LAKEHOUSE_KAFKA_POD=

# [object_store]
LAKEHOUSE_OBJECT_STORE_KIND=s3
LAKEHOUSE_OBJECT_STORE_S3_ENDPOINT=http://OBJECT_STORE_HOST:8333
LAKEHOUSE_OBJECT_STORE_BUCKET=lakehouse
LAKEHOUSE_OBJECT_STORE_WAREHOUSE=s3://lakehouse/warehouse
LAKEHOUSE_OBJECT_STORE_REGION=
LAKEHOUSE_OBJECT_STORE_PATH_STYLE=true
LAKEHOUSE_OBJECT_STORE_ACCESS_KEY_ENV=LAKEHOUSE_S3_ACCESS_KEY
LAKEHOUSE_OBJECT_STORE_SECRET_KEY_ENV=LAKEHOUSE_S3_SECRET_KEY

# [mlflow]
LAKEHOUSE_MLFLOW_TRACKING_URI=http://MLFLOW_HOST:5000
LAKEHOUSE_MLFLOW_GATEWAY_URI=http://MLFLOW_HOST:5001
LAKEHOUSE_MLFLOW_CONTAINER=
LAKEHOUSE_MLFLOW_POD=

# [airflow]
LAKEHOUSE_AIRFLOW_BASE_URL=http://AIRFLOW_HOST:8080
LAKEHOUSE_AIRFLOW_CONTAINER=
LAKEHOUSE_AIRFLOW_POD=
LAKEHOUSE_AIRFLOW_USERNAME_ENV=
LAKEHOUSE_AIRFLOW_PASSWORD_ENV=

# [delta_sharing]
LAKEHOUSE_DELTA_SHARING_ENDPOINT=https://SHARING_HOST:8443
LAKEHOUSE_DELTA_SHARING_BEARER_TOKEN_ENV=

# [naming]
LAKEHOUSE_NAMING_DEFAULT_CATALOG=lakehouse
LAKEHOUSE_NAMING_SCHEMAS=bronze,silver,gold
