# Lakehouse connection profile — the open-lakehouse REFERENCE STACK, .env form.
# Same values as reference-stack.profile.toml (see it for the per-value citations into
# open-lakehouse/open-lakehouse @ 39f32e68191828f39dc1f21d41d20506b5d4a292). Not the
# generic template: it carries this stack's remaps (UC 8081, Airflow 8085, SeaweedFS 8333).
LAKEHOUSE_PROFILE_NAME=reference-stack
LAKEHOUSE_PROFILE_INVOCATION=docker

LAKEHOUSE_SPARK_CONNECT_URI=sc://localhost:15002
LAKEHOUSE_SPARK_CONTAINER=spark-master-41

LAKEHOUSE_UNITY_CATALOG_REST_URL=http://localhost:8081/api/2.1/unity-catalog
LAKEHOUSE_UNITY_CATALOG_ICEBERG_REST=http://localhost:8081/api/2.1/unity-catalog/iceberg

LAKEHOUSE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
LAKEHOUSE_KAFKA_CONTAINER=kafka

LAKEHOUSE_OBJECT_STORE_KIND=s3
LAKEHOUSE_OBJECT_STORE_S3_ENDPOINT=http://localhost:8333
LAKEHOUSE_OBJECT_STORE_BUCKET=lakehouse
LAKEHOUSE_OBJECT_STORE_WAREHOUSE=s3a://lakehouse/warehouse
LAKEHOUSE_OBJECT_STORE_REGION=us-east-1
LAKEHOUSE_OBJECT_STORE_PATH_STYLE=true
LAKEHOUSE_OBJECT_STORE_ACCESS_KEY_ENV=S3_ACCESS_KEY
LAKEHOUSE_OBJECT_STORE_SECRET_KEY_ENV=S3_SECRET_KEY

LAKEHOUSE_MLFLOW_TRACKING_URI=http://localhost:5000
LAKEHOUSE_MLFLOW_GATEWAY_URI=http://localhost:5001
LAKEHOUSE_MLFLOW_CONTAINER=mlflow-server

LAKEHOUSE_AIRFLOW_BASE_URL=http://localhost:8085
LAKEHOUSE_AIRFLOW_CONTAINER=airflow-webserver
LAKEHOUSE_AIRFLOW_USERNAME_ENV=AIRFLOW_ADMIN_USER
LAKEHOUSE_AIRFLOW_PASSWORD_ENV=AIRFLOW_ADMIN_PASSWORD

LAKEHOUSE_DELTA_SHARING_ENDPOINT=https://localhost:8443/delta-sharing
LAKEHOUSE_DELTA_SHARING_BEARER_TOKEN_ENV=DELTA_SHARING_TOKEN
